# Opción 1: una sola cadena de conexión (Neon, Supabase...). Si existe, se ignoran las DB_*.
DATABASE_URL=

# Opción 2: variables separadas (PostgreSQL local o docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jac_honduras
DB_USER=postgres
DB_PASSWORD=
# "true" cuando la base de datos exige SSL (Supabase, Render Postgres, etc.);
# dejar en blanco/"false" para una Postgres local sin SSL.
DB_SSL=
PORT=3000
# "production" activa HSTS, bloquea las credenciales de prueba y exige un JWT_SECRET fuerte.
NODE_ENV=development
# Mínimo 32 caracteres aleatorios. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=1h

# Administrador: si se define, al arrancar crea el admin o reemplaza la
# contraseña por defecto (admin123). Mínimo 12 caracteres.
ADMIN_USUARIO=admin
ADMIN_PASSWORD=

# Solo si el frontend se sirve desde otro dominio (separados por coma).
CORS_ORIGIN=

# Notificaciones por correo al publicar una noticia (opcional).
# Deja estas 4 en blanco para desactivar el envío de correos sin que falle nada.
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=tu_correo@gmail.com,
# SMTP_PASS=una "contraseña de aplicación" (no la contraseña normal de la cuenta,
# se genera en https://myaccount.google.com/apppasswords con verificación en 2 pasos activada).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SITE_URL=http://localhost:3000

# Archivos subidos en Cloudinary (recomendado en Render). Si se deja vacío, los
# archivos se guardan en backend/uploads (sirve en local, NO en Render gratis).
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
